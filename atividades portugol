  }
}

programa {
  funcao inicio() {
    real altura, base, area

    escreva("area do triangulo\n")

    escreva("altura: ")
    leia(altura)
    escreva("base: ")
    leia(base)

    area = (base * altura) / 2

    escreva("area do triangulo ", area, "\n")
  }
}

programa {
  inclua biblioteca Texto --> t

  funcao inicio() {
    inteiro idade
    cadeia resposta
    logico temIngresso, entrada

    escreva("idade: ")
    leia(idade)

    escreva("possui ingresso (sim/nao): ")
    leia(resposta)

    temIngresso = (t.caixa_alta(resposta) == "SIM")
    entrada = falso

    se (idade >= 18 e temIngresso) {
      entrada = verdadeiro
    }

    se (entrada) {
      escreva("pode entrar\n")
    } senao {
      escreva("nao pode entrar\n")
    }
  }
}

programa {
  funcao inicio() {
    inteiro idade

    escreva("classificação de idade: criança, adolescente, adulto, idoso\n")

    escreva("insira sua idade: ")
    leia(idade)

    se (idade >= 0 e idade < 12) {
      escreva("voce é criança\n")
    } senao se (idade >= 12 e idade < 18) {
      escreva("voce é adolescente\n")
    } senao se (idade >= 18 e idade < 60) {
      escreva("voce é adulto\n")
    } senao se (idade >= 60) {
      escreva("voce é idoso\n")
    } senao {
      escreva("idade invalida\n")
    }
  }
}

