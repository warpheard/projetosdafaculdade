programa {
  funcao inicio() {
    inteiro opcao

    escreva("====OPÇÕES/ESCOLHA FORMA DE PAGAMENTO====\n")
    escreva("1 - Dinheiro\n")
    escreva("2 - Cartão\n")
    escreva("3 - Cartão\n")
    escreva("4 - PIX\n")
    escreva("5 - Boleto\n")

    escreva("Escolha uma opção: ")
    leia(opcao)

    escreva("Opção escolhida: ", escolhaPagamento(opcao), "\n")
  }

  funcao cadeia escolhaPagamento(inteiro opcao) {
    cadeia resultado

    se (opcao == 1) {
      resultado = "Dinheiro"
    } senao se (opcao == 2) {
      resultado = "Cartão"
    } senao se (opcao == 3) {
      resultado = "Cartão"
    } senao se (opcao == 4) {
      resultado = "PIX"
    } senao se (opcao == 5) {
      resultado = "Boleto"
    } senao {
      resultado = "Opção inválida"
    }

    retorne resultado
  }
}

 programa {
  funcao inicio() {
    real valorCompra, valorFinal

    escreva("desconto progressivo: compra\n")

    escreva("insira o valor da compra: R$ ")
    leia(valorCompra)

    valorFinal = calculaDesconto(valorCompra)

    escreva("valor final: R$ ", valorFinal, "\n")

    se (valorFinal == valorCompra) {
      escreva("Nao tem desconto!\n")
    }
  }

  funcao real calculaDesconto(real valorCompra) {
    se (valorCompra >= 100 e valorCompra < 300) {
      retorne valorCompra * 0.90
    } senao se (valorCompra >= 300 e valorCompra < 500) {
      retorne valorCompra * 0.85
    } senao se (valorCompra >= 500) {
      retorne valorCompra * 0.80
    }

    retorne valorCompra
  }
}
