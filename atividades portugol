    se (operador == "+") {
      escreva("resultado: ", a + b, "\n")
    } senao se (operador == "-") {
      escreva("resultado: ", a - b, "\n")
    } senao se (operador == "*") {
      escreva("resultado: ", a * b, "\n")
    } senao se (operador == "/") {
      se (b != 0) {
        escreva("resultado: ", a / b, "\n")
      } senao {
        escreva("invalido!\n")
      }
    } senao {
      escreva("operador inválido\n")
    }
  }
}

