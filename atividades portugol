programa {
  const cadeia CHAVE_ACESSO_CORRETA = "12345"

  funcao inicio() {
    cadeia chaveDigitada
    real salario, percentual, aumento, novoSalario

    escreva("=== Calculador de Aumento ===\n")

    escreva("Insira a chave de acesso para autorizar o aumento: ")
    leia(chaveDigitada)

    se (chaveDigitada == CHAVE_ACESSO_CORRETA) {
      escreva("Chave de acesso correta. Prosseguindo com o cálculo do aumento.\n")

      escreva("Insira seu salario: ")
      leia(salario)

      escreva("Qual o percentual do aumento? ")
      leia(percentual)

      aumento = (percentual * salario) / 100
      novoSalario = salario + aumento

      escreva("O aumento é de: ", aumento, "\n")
      escreva("O novo salário é: ", novoSalario, "\n")
    } senao {
      escreva("Acesso negado. Chave de acesso incorreta.\n")
    }
  }
}

